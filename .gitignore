node_modules/
dist/
.astro/
.DS_Store

# Local agent and browser automation state.
# settings.json / hooks / rules / agents and project-owned skills are tracked;
# other locally installed skills remain ignored.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/rules/
!.claude/agents/
!.claude/README.md
!.claude/skills/
.claude/skills/*
!.claude/skills/starlight-authoring/
.playwright-mcp/
# pi coding agent local state (mesh config, etc.)
.pi/

# Generated verification artifacts
output/
screenshot-*.png
panzoom-*.png
playground-*.png
site/test-results/
site/.lighthouseci/
.serena/
.pi-subagents/

# Environment / secrets
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.secret
*.pem
*.key

# Codex プラグインのローカル生成物(絶対パスを含む個人ローカル層)
.codex/

# Codex CLI / agent-assets symlink (~/.agents) / pi のローカル生成物・個人状態。
# いずれも絶対パスや個人環境固有の値を含みうる個人ローカル層で、
# 共有すると他の環境で壊れる (keroway/agent-assets#186)
# 末尾スラッシュの相対パターンはリポジトリ直下のシンボリックリンクにマッチしないため
# ルート限定の /.agents にする (CodeRabbit 指摘)。
/.agents
