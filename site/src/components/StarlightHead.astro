---
import Default from "@astrojs/starlight/components/Head.astro";
import {
  breadcrumbLd,
  faqPageLd,
  graphLd,
  organizationLd,
  type BreadcrumbItem,
} from "../lib/seo-jsonld";
import { getSiteUrl } from "../lib/site";
import { getT } from "../i18n/index";

const siteUrl = getSiteUrl(Astro);
const route = Astro.locals.starlightRoute;
const isJa = route.lang === "ja";
const docsHomeId = "docs";

const homeUrl = isJa ? "/" : "/en/";
const docsHomeUrl = isJa ? "/docs/" : "/en/docs/";
const docsHomeLabel = getT(isJa ? "ja" : "en")("docs.breadcrumb.docs");
const siteLabel = "Timeline DSL";

const pageTitle = route.entry?.data.title ?? siteLabel;
const currentPath = new URL(Astro.url).pathname;

const breadcrumbItems: BreadcrumbItem[] = [
  { name: siteLabel, url: homeUrl },
  { name: docsHomeLabel, url: docsHomeUrl },
];

if (route.id !== docsHomeId && currentPath !== docsHomeUrl) {
  breadcrumbItems.push({ name: pageTitle, url: currentPath });
}

const locale = isJa ? "ja" : "en";
const faqId = isJa ? "docs/faq" : "en/docs/faq";
const isFaqPage = route.id === faqId;
const faqNodes =
  isFaqPage && route.entry?.data.faqs
    ? [faqPageLd({ siteUrl, pathname: currentPath, locale, faqs: route.entry.data.faqs })]
    : [];

const jsonLd = graphLd([
  organizationLd(siteUrl),
  breadcrumbLd(breadcrumbItems, siteUrl),
  ...faqNodes,
]);

// Starlight は og:title/og:description/og:url/og:type/og:site_name/og:locale を自前で
// 出力するが og:image 系は出力しない（#683）。SocialMeta.astro とは別パイプラインのため
// ここで docs 種別の OG 画像メタだけを追加する。
const ogImageUrl = new URL("/og/docs.png", siteUrl).toString();
---

<Default />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={pageTitle} />
<script is:inline type="application/ld+json" set:html={jsonLd} />
