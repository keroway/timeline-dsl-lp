---
// Playground のエディタ枠（CodeMirror のマウント対象）。
// クライアント挙動は playground-controller.ts / playground-editor.ts が担う。
import { getT, interpolate, type Locale } from "../../i18n/index";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);
---

<div class="playground-panel editor-workbench">
  <div class="playground-panel-bar">
    <span>source.tdsl</span>
    <span data-editor-meta>{interpolate(t("playground.editor.lines"), { count: "0" })}</span>
  </div>
  <div class="cm-editor-host" data-editor-host data-smoke="playground-editor"></div>
</div>
