{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 4am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "ignorePaths": [
    "**/node_modules/**",
    "site/public/wasm/**"
  ],
  "packageRules": [
    {
      "description": "@lhci/cli 0.16 は lighthouse 13.6 > puppeteer-core 25.16 > chromium-bidi 157.0.8090-0 を引き込み、pnpm の trustPolicy(no-downgrade) が解決を拒否する。chromium-bidi が trust 証跡付きで再公開されるまで 0.15.x に据え置く",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@lhci/cli"],
      "allowedVersions": "<0.16.0"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "chore",
      "groupName": "npm minor/patch",
      "groupSlug": "npm-minor-patch"
    },
    {
      "description": "major は意図しない破壊的変更を防ぐためブロックし、手動で追従する",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "chore",
      "groupName": "github-actions"
    },
    {
      "description": "major は意図しない破壊的変更を防ぐためブロックし、手動で追従する",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
